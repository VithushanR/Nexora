# Required. Used for OpenAlex/Crossref polite-pool attribution and the
# outgoing User-Agent. backend/sources/base.py raises at import time if this
# is missing, so nothing runs without it.
CONTACT_EMAIL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

OPENALEX_MAILTO=
SEMANTIC_SCHOLAR_API_KEY=

# Optional. Enables strategies 6 & 7 of Agent 3's full-text cascade.
# Without it the cascade still works, with five strategies instead of seven.
CORE_API_KEY=

# --- tuning (all optional, defaults shown) ---
SCREENING_CANDIDATE_CAP=150
SYNTHESIS_PAPER_CONCURRENCY=4
CONTRADICTION_SIMILARITY_THRESHOLD=0.55
MAX_CONTRADICTION_PAIRS=20
CONTRADICTION_PAIR_CONCURRENCY=4
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Research thread persistence (all optional, defaults shown) ---
# LangGraph checkpoint DB (protocol/candidates/report state per thread_id).
SQLITE_DB_PATH=nexora_checkpoints.sqlite
# API-facing thread metadata (owner, domain, status) -- see research_threads.py.
THREAD_METADATA_DB_PATH=nexora_threads.sqlite

# --- Document uploads (Part D) (all optional, defaults shown) ---
UPLOAD_DIR=backend/uploads
UPLOAD_MAX_SIZE_MB=20


# --- Authentication / JWT ---
# Secret key used to sign and verify JSON Web Tokens (JWTs).
# Keep this value secret and do not commit it to version control.

JWT_SECRET_KEY=

# JWT token expiration time in minutes.
JWT_EXPIRY_MINUTES=60

# Embedding model used by the RAG pipeline to convert text into vector representations.
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Secret key used for application data encryption and decryption.
ENCRYPTION_KEY=

# Google OAuth Client ID used for Google Sign-In authentication
GOOGLE_OAUTH_CLIENT_ID=