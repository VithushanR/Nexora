VITE_API_BASE_URL=http://localhost:8001

# Google OAuth Client ID used for Google Sign-In (Google Identity Services).
# MUST match the backend's GOOGLE_OAUTH_CLIENT_ID exactly -- if they differ,
# sign-in will complete on the frontend but the backend's audience check in
# auth/google_auth.py will reject the token every time.
VITE_GOOGLE_CLIENT_ID=
